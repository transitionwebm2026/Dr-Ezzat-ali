{
  "name": "dr-ezzat-ali",
  "version": "1.0.0",
  "private": true,
  "description": "Bilingual (Arabic / English) static website for Dr. Ezzat Ali, Consultant Ophthalmologist.",
  "scripts": {
    "predev": "node --env-file-if-exists=.env.local scripts/cms-pull.mjs",
    "dev": "node --env-file-if-exists=.env.local scripts/dev.mjs",
    "prebuild": "node --env-file-if-exists=.env.local scripts/cms-pull.mjs",
    "build": "next build",
    "postbuild": "node scripts/fix-static-export.mjs",
    "start": "npx serve@14 out",
    "pretypecheck": "node scripts/cms-pull.mjs --if-missing",
    "typecheck": "tsc --noEmit",
    "cms:pull": "node --env-file-if-exists=.env.local scripts/cms-pull.mjs",
    "cms:seed-sql": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/generate-seed.mjs",
    "cms:create-admin": "node --env-file-if-exists=.env.local scripts/create-admin.mjs"
  },
  "engines": {
    "node": ">=22.18"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.117.2",
    "framer-motion": "^14.3.1",
    "lucide-react": "^1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.9.3"
  }
}
