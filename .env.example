# Copy to `.env.local` (git-ignored) and fill in. Supabase → Project Settings → API Keys.

# Public — inlined into the static site; safe because every table is protected by RLS.
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# SECRET — bypasses RLS. Only for `npm run cms:create-admin` on a trusted machine.
# Never prefix with NEXT_PUBLIC_, never add it to GitHub Actions, never commit it.
SUPABASE_SERVICE_ROLE_KEY=

# Optional override for cms:create-admin (pass ADMIN_PASSWORD inline for that one run instead of saving it here).
# ADMIN_EMAIL=Dr.ezzatali.web@hotmail.com
